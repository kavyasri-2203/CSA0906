import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        ArrayList<String> points = new ArrayList<>();

        System.out.print("Enter Number of Clicks: ");
        int n = sc.nextInt();

        for (int i = 1; i <= n; i++) {
            System.out.print("Enter X coordinate: ");
            int x = sc.nextInt();

            System.out.print("Enter Y coordinate: ");
            int y = sc.nextInt();

            points.add("(" + x + "," + y + ")");
        }

        System.out.println("\nTotal Clicks: " + points.size());
        System.out.println("Stored Drawing Points:");

        for (String p : points)
            System.out.println(p);

        System.out.println("Drawing Completed");
    }
}
