
import java.io.*;
import java.nio.file.*;
import java.util.*;

public class Main {

    static class PassStore {
        String file = "passes.txt";

        void add(String id, String reg, String name,
                 int route, double amount) throws IOException {
            try (BufferedWriter w = new BufferedWriter(
                    new FileWriter(file, true))) {
                w.write(id + "," + reg + "," + name + "," +
                        route + "," + amount);
                w.newLine();
            }
        }

        String[] find(String id) throws IOException {
            File f = new File(file);
            if (!f.exists()) return null;

            try (BufferedReader r = new BufferedReader(
                    new FileReader(f))) {
                String line;

                while ((line = r.readLine()) != null) {
                    String[] p = line.split(",", -1);

                    if (p.length != 5) continue;

                    try {
                        Integer.parseInt(p[3]);
                        Double.parseDouble(p[4]);
                    } catch (NumberFormatException e) {
                        continue;
                    }

                    if (p[0].equals(id))
                        return p;
                }
            }
            return null;
        }

        void list(int route) throws IOException {
            File f = new File(file);
            if (!f.exists()) return;

            try (BufferedReader r = new BufferedReader(
                    new FileReader(f))) {
                String line;

                while ((line = r.readLine()) != null) {
                    String[] p = line.split(",", -1);

                    if (p.length != 5) continue;

                    try {
                        if (Integer.parseInt(p[3]) == route)
                            System.out.println(line);
                    } catch (NumberFormatException e) {
                        continue;
                    }
                }
            }
        }
    }

    public static void main(String[] args) throws Exception {
        PassStore store = new PassStore();

        new File("passes.txt").delete();

        store.add("P1001", "192311001", "Arun", 12, 4500);
        store.add("P1003", "192311003", "Divya", 7, 3800);

        System.out.println(Arrays.toString(store.find("P1003")));
        System.out.println(Arrays.toString(store.find("P1002")));

        System.out.println("Route 12 Passes:");
        store.list(12);

        long count = 0;

        try (BufferedReader r = new BufferedReader(
                new FileReader("passes.txt"))) {
            while (r.readLine() != null)
                count++;
        }

        System.out.println("Total Lines: " + count);
    }
}
