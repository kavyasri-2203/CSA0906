
import java.io.*;

public class Main {
    public static void main(String[] args) {

        try {
            try (FileWriter f1 = new FileWriter("store1.txt")) {
                f1.write("Store 1 Sales: 5000\n");
            }

            try (FileWriter f2 = new FileWriter("store2.txt")) {
                f2.write("Store 2 Sales: 7000\n");
            }

            String[] files = {"store1.txt", "store2.txt"};

            try (BufferedWriter report =
                     new BufferedWriter(new FileWriter("report.txt"))) {

                for (String file : files) {
                    try (BufferedReader br =
                         new BufferedReader(new FileReader(file))) {

                        String line;
                        while ((line = br.readLine()) != null) {
                            System.out.println(line);
                            report.write(line);
                            report.newLine();
                        }
                    }
                }
            }

            System.out.println("Report Generated Successfully");

        } catch (IOException e) {
            System.out.println("File Error: " + e.getMessage());
        }
    }
}
