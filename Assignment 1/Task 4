class ParkingTicket {
    String vehicleNo;
    int ticketNo;

    ParkingTicket() {
        this("UNKNOWN", 0);
    }

    ParkingTicket(String vehicleNo, int ticketNo) {
        this.vehicleNo = vehicleNo;
        this.ticketNo = ticketNo;
    }

    ParkingTicket(ParkingTicket t) {
        this(t.vehicleNo, t.ticketNo);
    }

    void display() {
        System.out.println(vehicleNo + " " + ticketNo);
    }
}

public class Main {
    public static void main(String[] args) {
        ParkingTicket t1 = new ParkingTicket();
        ParkingTicket t2 = new ParkingTicket("TN01AB1234", 101);
        ParkingTicket t3 = new ParkingTicket(t2);

        t1.display();
        t2.display();
        t3.display();
    }
}
