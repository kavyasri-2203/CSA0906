class Vehicle {
    String regNo, type;

    Vehicle(String regNo, String type) {
        this.regNo = regNo;
        this.type = type;
    }

    void display() {
        System.out.println(regNo + " " + type);
    }
}

class ParkingSlot {
    int slotNo;
    boolean occupied;

    void park() {
        occupied = true;
        System.out.println("Vehicle Parked");
    }
}

public class Main {
    public static void main(String[] args) {
        Vehicle v = new Vehicle("TN01AB1234", "Car");
        ParkingSlot s = new ParkingSlot();

        v.display();
        s.park();
    }
}
