class ParkingTicket {
    static int ticketCount = 1000;
    int ticketNo;

    ParkingTicket() {
        ticketNo = ++ticketCount;
    }

    static void showCount() {
        System.out.println("Total Tickets: " + (ticketCount - 1000));
    }

    void display() {
        System.out.println("Ticket Number: " + ticketNo);
    }
}

public class Main {
    public static void main(String[] args) {
        ParkingTicket t1 = new ParkingTicket();
        ParkingTicket t2 = new ParkingTicket();
        ParkingTicket t3 = new ParkingTicket();

        t1.display();
        t2.display();
        t3.display();

        ParkingTicket.showCount();
    }
}
