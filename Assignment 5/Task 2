import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter Patient ID: ");
        String id = sc.nextLine();

        if (id.trim().isEmpty()) {
            System.out.println("Invalid Patient ID");
            return;
        }

        System.out.println("1. Cardiology");
        System.out.println("2. Neurology");
        System.out.println("3. Orthopedics");

        System.out.print("Select Department: ");
        int choice = sc.nextInt();
        sc.nextLine();

        String[] doctors;

        switch (choice) {
            case 1:
                doctors = new String[]{"Dr. Kumar", "Dr. Ravi"};
                break;
            case 2:
                doctors = new String[]{"Dr. Priya", "Dr. Arun"};
                break;
            case 3:
                doctors = new String[]{"Dr. Meena", "Dr. Raj"};
                break;
            default:
                System.out.println("Invalid Department");
                return;
        }

        System.out.println("Available Doctors:");
        for (int i = 0; i < doctors.length; i++)
            System.out.println((i + 1) + ". " + doctors[i]);

        System.out.print("Select Doctor: ");
        int d = sc.nextInt();

        if (d < 1 || d > doctors.length) {
            System.out.println("Invalid Doctor");
            return;
        }

        sc.nextLine();
        System.out.print("Enter Time Slot: ");
        String time = sc.nextLine();

        System.out.println("\nAppointment Booked Successfully!");
        System.out.println("Patient ID: " + id);
        System.out.println("Doctor: " + doctors[d - 1]);
        System.out.println("Time: " + time);
    }
}
